<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Status colours are chosen for contrast against both light and dark surfaces and
         are always paired with a text label, never used as the sole signal — a status
         conveyed by colour alone is invisible to a colour-blind or screen-reader user. -->
    <color name="status_ok">#2E7D32</color>
    <color name="status_pending">#EF6C00</color>
    <color name="status_error">#C62828</color>
    <color name="status_stopped">#616161</color>

    <color name="brand_primary">#1B6EF3</color>
    <color name="brand_on_primary">#FFFFFF</color>
</resources>
