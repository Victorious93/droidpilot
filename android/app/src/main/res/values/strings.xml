<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">DroidPilot Forge</string>
    <string name="app_tagline">Accessibility-based device automation for MCP clients</string>

    <!--
      Shown verbatim on the system Accessibility consent screen. It states plainly what the
      service does and that it accepts remote commands, because that is the fact a user
      needs in order to give informed consent — and because an accessibility service that
      understates its reach is one users are right to distrust.
    -->
    <string name="accessibility_service_description">DroidPilot Forge reads the on-screen content of other apps and performs taps, swipes and text input on your behalf. While the DroidPilot Forge server is running, these actions can be requested by an AI assistant on your local network that you have paired with this device using its pairing secret. Nothing is sent to the internet, and the server only runs while you have started it.</string>

    <string name="accessibility_on">Accessibility service: on</string>
    <string name="accessibility_off">Accessibility service: off</string>
    <string name="accessibility_hint">DroidPilot Forge needs this permission to read the screen and perform gestures. The server cannot run without it.</string>
    <string name="btn_open_accessibility">Open Accessibility settings</string>

    <string name="status_stopped">Server stopped</string>
